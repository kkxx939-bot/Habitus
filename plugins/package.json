{
  "name": "habitus",
  "version": "0.1.0",
  "description": "Habitus command line: install the Habitus memory and reminder plugins into coding agents (Codex, Claude Code, OpenCode, pi, ZCode, DeepSeek Harness), check and query the local Habitus service.",
  "type": "module",
  "bin": {
    "habitus": "bin/habitus.mjs"
  },
  "files": [
    "bin/",
    "harnesses.mjs",
    "install-memory-plugin.mjs",
    "registrations.mjs",
    "memory-plugin-shared/doctor.mjs",
    "memory-plugin-shared/lib/",
    "habitus-memory/",
    "habitus-memory-claude-code/",
    "habitus-memory-opencode/",
    "habitus-memory-pi/",
    "habitus-memory-dsh/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkxx939-bot/Habitus.git",
    "directory": "plugins"
  },
  "homepage": "https://github.com/kkxx939-bot/Habitus/tree/main/plugins#readme",
  "bugs": {
    "url": "https://github.com/kkxx939-bot/Habitus/issues"
  },
  "keywords": [
    "habitus",
    "memory",
    "agent",
    "codex",
    "claude-code",
    "opencode",
    "pi",
    "zcode",
    "deepseek-harness",
    "cli"
  ],
  "scripts": {
    "sync": "node memory-plugin-shared/sync.mjs",
    "test": "node --test memory-plugin-shared/test/*.test.mjs",
    "prepublishOnly": "npm test"
  }
}
