{
  "name": "@habitus/cli",
  "version": "0.1.0",
  "description": "Habitus command line: install agent plugins (Codex, Claude Code, OpenCode), check and query the local Habitus service.",
  "type": "module",
  "bin": {
    "habitus": "bin/habitus.mjs"
  },
  "files": [
    "bin/",
    "harnesses.mjs",
    "install-memory-plugin.mjs",
    "memory-plugin-shared/doctor.mjs",
    "memory-plugin-shared/lib/",
    "habitus-memory/",
    "habitus-memory-claude-code/",
    "habitus-memory-opencode/"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": ["habitus", "memory", "agent", "codex", "claude-code", "opencode", "cli"],
  "scripts": {
    "sync": "node memory-plugin-shared/sync.mjs",
    "test": "node --test memory-plugin-shared/test/*.test.mjs"
  }
}
