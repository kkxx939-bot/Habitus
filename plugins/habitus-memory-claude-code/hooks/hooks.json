    "SessionEnd": [
      {"matcher": "", "hooks": [{"type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs", "timeout": 60}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/subagent-start.mjs", "timeout": 30}]}
    ],
    "SubagentStop": [
